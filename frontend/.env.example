# 복사해서 .env 로 만들고 값을 채워요. (.env 는 git에 올라가지 않아요)
# 비워 두면 체험 모드: 로그인은 이 기기 안에서만, 영수증은 휴대폰에서 인식

# Supabase → Project Settings → API (anon 키만! service_role 키는 절대 넣지 않기)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# FastAPI 서버 주소 (영수증 OCR, 문의 저장). 예: https://domain-api.onrender.com
VITE_API_BASE=

# GA4 측정 ID. 예: G-ABC123XYZ
VITE_GA4_ID=
